{
  "name": "webhooks-dot-email",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "node scripts/check-secrets.mjs",
    "deploy": "wrangler deploy",
    "check:secrets": "node scripts/check-secrets.mjs",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "db:apply": "wrangler d1 execute webhooks-email-db --remote --file=./src/db/schema.sql",
    "db:seed": "node --experimental-strip-types scripts/seed-test-key.ts",
    "cf:meters": "node scripts/create-stripe-meters.mjs",
    "test": "node --experimental-strip-types --no-warnings test/run-tests.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "postal-mime": "^2.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.47.0"
  }
}
