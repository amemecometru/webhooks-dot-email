{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "senders",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "workers_dev": true,
  "preview_urls": true,

  "routes": [
    { "pattern": "webhooks.email", "custom_domain": true },
    { "pattern": "mcp.webhooks.email", "custom_domain": true },
    { "pattern": "api.webhooks.email", "custom_domain": true }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webhooks-email-db",
      "database_id": "<add-db-id-here>"
    }
  ],

  "send_email": [
    { "name": "EMAIL" }
  ],

  "ai": {
    "binding": "AI"
  },

  "triggers": {
    "crons": [
      "* * * * *",
      "0 0 * * 1"
    ]
  },

  "vars": {
    "ENVIRONMENT": "production",
    "API_HOST": "api.webhooks.email",
    "MCP_HOST": "mcp.webhooks.email",
    "OUTBOUND_EMAIL": "noreply@webhooks.email",
    "WEBHOOK_TIMEOUT_MS": "10000",
    "MAX_RETRIES": "5",
    "AUTH_CACHE_TTL_SECONDS": "3600",
    "KEY_PBKDF2_ITERATIONS": "100000",
    "DELIVERY_BATCH_SIZE": "25",
    "CHARGE_ENDPOINT": "email.send",
    "CHARGE_WEBHOOK_ENDPOINT": "webhook.send",
    "CHARGE_INBOUND_ENDPOINT": "email.inbound",
    "KEYS_PER_IP_PER_DAY": "5",
    "SEND_PER_AGENT_PER_MINUTE": "60",
    "INBOUND_PER_ROUTE_PER_DAY": "1000",
    "INBOUND_WILDCARD_PER_DAY": "200",
    "PAID_INBOXES_MAX": "100",
    "FREE_INBOXES_MAX": "3",
    "FREE_INBOUND_PER_DAY": "100",
    "FREE_SEND_PER_MONTH": "100",
    "SANDBOX_LINK_TTL_SECONDS": "86400",
    "RETENTION_DAYS_FREE": "7",
    "RETENTION_DAYS_PAID": "30",
    "REPLY_WINDOW_DAYS": "30",
    "REPLY_PER_INBOX_PER_HOUR": "60"
  }
}
